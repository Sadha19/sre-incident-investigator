# Copy this file to .env and replace the placeholders. Never commit .env.

# Optional LLM support; deterministic investigation works without these.
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=replace-with-your-model-name
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60

# Investigation scope and dependencies.
SRE_DEFAULT_NAMESPACE=sre-lab
SRE_ALLOWED_NAMESPACES=sre-lab
PROMETHEUS_URL=http://localhost:9090
K8S_TIMEOUT_SECONDS=10
PROMETHEUS_TIMEOUT_SECONDS=10

# Resource budgets.
INVESTIGATION_DEADLINE_SECONDS=120
LOG_TAIL_LINES=200

# Remediation is intentionally disabled unless explicitly enabled.
SRE_AGENT_ALLOW_WRITES=false
REMEDIATION_COOLDOWN_SECONDS=1800
REMEDIATION_STATE_FILE=.sre_agent_state.json
